---
import { catalogueFor } from "../diagrams/engine/catalogue_for";
import { localeOf } from "../diagrams/engine/locale_of";
import { notaryVerifier, verifierPath } from "../site/notary_verifier";
import NotaryVerifier from "../verifier/NotaryVerifier.svelte";
import type { VerifierConfig } from "../verifier/types/verifier_config.type";
import { verifierLabels } from "../verifier/verifier_labels";

type Props = {
  proveHref: string;
};

const { proveHref } = Astro.props;
const labels = verifierLabels(catalogueFor(localeOf(Astro.locals.starlightRoute.entryMeta.lang)));
const { module, runtime, network } = notaryVerifier;
const config: VerifierConfig = {
  release: notaryVerifier.release,
  sources: {
    module: { url: verifierPath(module.file), sha256: module.sha256, bytes: module.bytes },
    runtime: { url: verifierPath(runtime.file), sha256: runtime.sha256, bytes: runtime.bytes }
  },
  defaults: {
    rpcUrl: network.rpcUrl,
    chainId: network.chainId,
    directory: network.directory
  },
  networkName: network.name,
  explorer: network.explorer
};
---

<NotaryVerifier client:visible labels={labels} config={config} proveHref={proveHref} />
<noscript><p>{labels.noscript}</p></noscript>
