---
import type { RestTextProps } from "../site/types/rest_text_props.type";

type Props = RestTextProps;

const { text } = Astro.props;
---

<pre class="rest-message"><code>{text}</code></pre>

<style>
  .rest-message {
    margin: 0.5rem 0 0;
    padding: 0.75rem 0.875rem;
    max-width: 100%;
    overflow-x: auto;
    background: var(--kx-surface);
    border: 1px solid var(--kx-rule);
    border-radius: var(--kx-radius);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    line-height: 1.55;
    color: var(--sl-color-white);
  }

  .rest-message code {
    padding: 0;
    background: none;
    border: 0;
    font-size: inherit;
    white-space: pre;
  }
</style>
