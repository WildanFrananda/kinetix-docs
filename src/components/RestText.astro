---
import { codeSpans } from "../site/rest/code_spans";
import type { RestTextProps } from "../site/types/rest_text_props.type";

type Props = RestTextProps;

const { text } = Astro.props;
const parts = codeSpans(text);
---

{parts.map((part, index) => (index % 2 === 1 ? <code>{part}</code> : part))}
