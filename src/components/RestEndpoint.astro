---
import { Code } from "@astrojs/starlight/components";
import "../styles/rest.css";
import { localeOf } from "../diagrams/engine/locale_of";
import { messagePayload } from "../site/rest/message_payload";
import { bff } from "../site/rest/bff";
import { methodTone } from "../site/rest/method_tone";
import { releaseTree } from "../site/rest/release_tree";
import { requestHeaders } from "../site/rest/request_headers";
import { requestLine } from "../site/rest/request_line";
import { restCatalogueFor } from "../site/rest/rest_catalogue";
import { restEndpoint } from "../site/rest/rest_endpoints";
import { restReleases } from "../site/rest/rest_releases";
import { servicePage } from "../site/rest/service_page";
import type { RestEndpointProps } from "../site/types/rest_endpoint_props.type";
import RestCaseBlock from "./RestCaseBlock.astro";
import RestFields from "./RestFields.astro";
import RestText from "./RestText.astro";

type Props = RestEndpointProps;

const { id, via } = Astro.props;
const locale = localeOf(Astro.locals.starlightRoute.entryMeta.lang);
const text = restCatalogueFor(locale);
const prefix = locale === "en" ? "" : `/${locale}`;
const endpoint = restEndpoint(id);
const release = restReleases[endpoint.service];
const page = servicePage(endpoint.service);
const headers = requestHeaders(endpoint, via);
const payload = messagePayload(endpoint.request);
const throughEdge = via !== undefined && endpoint.service !== "edge";
const toIdentity = throughEdge && bff.identityPaths.some((path) => endpoint.path.startsWith(`${path}/`));
const token = throughEdge ? text["rest.common.token.session"] : text[`rest.common.token.${endpoint.access.token}`];
const gateway =
  endpoint.access.token === "none" || toIdentity
    ? undefined
    : endpoint.access.gatewayVerifies
      ? text["rest.common.gateway.verifies"]
      : text["rest.common.gateway.passes"];
---

<section class="rest-endpoint not-content">
  <p class="rest-line">
    <span class={`rest-method rest-tone-${methodTone(endpoint.method)}`}>{endpoint.method}</span>
    <code class="rest-path">{endpoint.path.split("/").map((part, index) => (<>{index > 0 && <>/<wbr /></>}{part}</>))}</code>
  </p>
  <p class="rest-summary"><RestText text={text[endpoint.summary]} /></p>
  <dl class="rest-facts">
    <dt>{text["rest.common.access"]}</dt>
    <dd>
      {token}
      {gateway !== undefined && <> <RestText text={gateway} /></>}
      {" "}
      <RestText text={text[endpoint.access.who]} />
    </dd>
    <dt>{text["rest.common.handler"]}</dt>
    <dd>
      {page === undefined ? endpoint.service : <a href={`${prefix}${page}`}>{endpoint.service}</a>}{" "}
      <a href={releaseTree(endpoint.service)}>{release.tag}</a>
      {" · "}
      <a class="rest-source" href={endpoint.source.href}>{endpoint.source.label}</a>
    </dd>
  </dl>
  <p class="rest-label">{text["rest.common.request"]}</p>
  <RestFields fields={endpoint.request.fields} />
  <div class="rest-parts">
    <Code code={requestLine(endpoint, via)} lang="http" title={text["rest.common.part.endpoint"]} />
    {headers.length > 0 && <Code code={headers.join("\n")} lang="http" title={text["rest.common.part.headers"]} />}
    {payload !== undefined && <Code code={payload.code} lang={payload.lang} title={text["rest.common.part.body"]} />}
  </div>
  <p class="rest-label">{text["rest.common.responses"]}</p>
  {endpoint.cases.map((entry) => <RestCaseBlock entry={entry} />)}
  <p class="rest-also">
    {text["rest.common.also"]}{" "}
    <a href={`${prefix}/apis/rest/#${endpoint.service}-answers`}>{text["rest.common.also.service"]}</a>
    {via !== undefined && endpoint.service !== "edge" && (
      <>
        {" · "}
        <a href={`${prefix}/apis/rest/#edge-answers`}>{text["rest.common.also.edge"]}</a>
      </>
    )}
    {endpoint.service !== "gateway" && (
      <>
        {" · "}
        <a href={`${prefix}/apis/rest/#gateway-answers`}>{text["rest.common.also.gateway"]}</a>
      </>
    )}
  </p>
</section>
