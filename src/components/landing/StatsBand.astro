---
import { getCollection } from "astro:content";
import { catalogueFor } from "../../diagrams/engine/catalogue_for";
import { localeOf } from "../../diagrams/engine/locale_of";
import { computeLandingStats } from "../../site/landing_data";

const locale = localeOf(Astro.locals.starlightRoute.entryMeta.lang);
const catalogue = catalogueFor(locale);
const entries = await getCollection("docs");
const lessons = entries.filter((entry) => /^learn\/.+/.test(entry.id)).length;
const adrs = entries.filter((entry) => entry.data.adr !== undefined && !entry.id.startsWith("id/")).length;
const stats = computeLandingStats(lessons, adrs);

const items = [
  { target: stats.services, label: catalogue["landing.stats.services"] },
  { target: stats.languages, label: catalogue["landing.stats.languages"] },
  { target: stats.grpcOperations, label: catalogue["landing.stats.grpc"] },
  { target: stats.restOperations, label: catalogue["landing.stats.rest"] },
  { target: stats.lessons, label: catalogue["landing.stats.lessons"] },
  { target: stats.adrs, label: catalogue["landing.stats.adrs"] }
];
---

<section class="kx-stats not-content" aria-labelledby="kx-stats-heading">
  <p id="kx-stats-heading" class="kx-section-kicker">{catalogue["landing.stats.kicker"]}</p>
  <dl class="kx-stats-grid" data-stats-grid>
    {
      items.map((item) => (
        <div class="kx-stat-cell">
          <svg class="kx-stat-ruler" viewBox="0 0 120 8" aria-hidden="true" preserveAspectRatio="none">
            <line class="kx-ruler-base" x1="0" y1="6" x2="120" y2="6" />
            <line class="kx-ruler-tick" x1="0" y1="2" x2="0" y2="6" />
            <line class="kx-ruler-tick" x1="30" y1="3.5" x2="30" y2="6" />
            <line class="kx-ruler-tick" x1="60" y1="2" x2="60" y2="6" />
            <line class="kx-ruler-tick" x1="90" y1="3.5" x2="90" y2="6" />
            <line class="kx-ruler-tick" x1="120" y1="2" x2="120" y2="6" />
            <line class="kx-ruler-accent" x1="0" y1="6" x2="120" y2="6" />
          </svg>
          <dd class="kx-stat-val" data-stat-target={item.target}>{item.target}</dd>
          <dt class="kx-stat-label">{item.label}</dt>
        </div>
      ))
    }
  </dl>
</section>

<script>
  const grid = document.querySelector<HTMLElement>("[data-stats-grid]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (grid && !reduceMotion && "IntersectionObserver" in window) {
    const cells = Array.from(grid.querySelectorAll<HTMLElement>("[data-stat-target]"));
    let animated = false;

    const animateCounts = () => {
      if (animated) {
        return;
      }
      animated = true;
      const start = performance.now();
      const duration = 640;

      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        for (const el of cells) {
          const target = Number(el.dataset.statTarget ?? "0");
          el.textContent = String(Math.round(target * eased));
        }
        if (t < 1) {
          requestAnimationFrame(tick);
        } else {
          for (const el of cells) {
            el.textContent = el.dataset.statTarget ?? el.textContent;
          }
        }
      };

      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          animateCounts();
        }
      },
      { threshold: 0.25 }
    );

    observer.observe(grid);
  }
</script>

<style>
  .kx-stats {
    padding-block: clamp(2rem, 4vw, 3rem);
    border-block: 1px solid var(--kx-land-border);
  }

  .kx-stats-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 1rem 0 0;
  }

  .kx-stat-cell {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--kx-land-border);
    border-radius: var(--kx-land-radius);
    background: var(--kx-land-card-bg);
    min-inline-size: 0;
    transition: border-color 0.2s ease, translate 0.3s ease-out;
    transition-timing-function: ease, linear(0, 0.45 20%, 1.06 55%, 0.99 80%, 1);
  }

  .kx-stat-cell:hover {
    border-color: var(--sl-color-accent);
  }

  .kx-stat-ruler {
    inline-size: 100%;
    block-size: 8px;
    margin-block-end: 0.15rem;
  }

  .kx-ruler-base,
  .kx-ruler-tick {
    stroke: var(--kx-land-border-strong);
    stroke-width: 1;
  }

  .kx-ruler-accent {
    stroke: var(--sl-color-accent);
    stroke-width: 1.5;
    stroke-dasharray: 120;
    stroke-dashoffset: 120;
    transition: stroke-dashoffset 0.42s ease-out;
  }

  .kx-stat-cell:hover .kx-ruler-accent {
    stroke-dashoffset: 0;
  }

  .kx-stat-val {
    margin: 0;
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .kx-stat-label {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.35;
  }

  @keyframes kx-stat-entry {
    from {
      opacity: 0.4;
      translate: 0 12px;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .kx-stat-cell:hover {
      translate: 0 -2px;
    }

    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .kx-stat-cell {
        animation: kx-stat-entry auto linear backwards;
        animation-timeline: view();
        animation-range: entry 0% entry 24%;
      }
    }
  }

  @media (max-width: 64rem) {
    .kx-stats-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .kx-stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }
</style>
