---
import { catalogueFor } from "../diagrams/engine/catalogue_for";
import { localeOf } from "../diagrams/engine/locale_of";
import { services } from "../site/services";
import TechLogo from "./TechLogo.astro";

const catalogue = catalogueFor(localeOf(Astro.locals.starlightRoute.entryMeta.lang));
---

<div class="manifest not-content">
  <p class="head" aria-hidden="true">
    <span class="col-service">{catalogue["services.column.service"]}</span>
    <span class="col-owns">{catalogue["services.column.owns"]}</span>
    <span class="col-stack">{catalogue["services.column.stack"]}</span>
  </p>
  <ol>
    {
      services.map((service) => (
        <li>
          <a href={service.repository} class="row" aria-label={`${service.name} — ${catalogue["services.source"]}`}>
            <span class="logos">
              <TechLogo tech={service.language} size="sm" />
              <TechLogo tech={service.framework} size="sm" />
            </span>
            <span class="name">{service.name}</span>
            <span class="owns">{catalogue[service.owns]}</span>
            <span class="stack">
              {service.language.name} · {service.framework.name}
              {service.framework.version && <span class="version">{service.framework.version}</span>}
            </span>
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .manifest {
    --columns: 4.25rem 9rem minmax(0, 1fr) 15rem 1rem;
    margin: 1.5rem 0 2rem;
    border-top: 2px solid var(--sl-color-white);
    border-bottom: 1px solid var(--sl-color-white);
  }

  .head {
    display: grid;
    grid-template-columns: var(--columns);
    gap: 1rem;
    margin: 0;
    padding: 0.5rem 0.5rem;
    border-bottom: 1px solid var(--sl-color-white);
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .col-service {
    grid-column: 1 / 3;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    margin: 0;
    border-bottom: 1px solid var(--kx-rule);
  }

  li:last-child {
    border-bottom: 0;
  }

  .row {
    display: grid;
    grid-template-columns: var(--columns);
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .row:hover,
  .row:focus-visible {
    background: var(--kx-surface);
  }

  .row:hover .name,
  .row:focus-visible .name,
  .row:hover .arrow {
    color: var(--sl-color-accent);
  }

  .logos {
    display: flex;
    gap: 0.3rem;
  }

  .name {
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-weight: 600;
  }

  .owns {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .stack {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .version {
    margin-inline-start: 0.35rem;
    font-family: var(--sl-font-mono);
  }

  .arrow {
    color: var(--sl-color-gray-4);
  }

  @media (max-width: 50rem) {
    .head {
      display: none;
    }

    .row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        "logos name arrow"
        "owns owns owns"
        "stack stack stack";
      gap: 0.35rem 0.75rem;
    }

    .logos {
      grid-area: logos;
    }

    .name {
      grid-area: name;
    }

    .arrow {
      grid-area: arrow;
    }

    .owns {
      grid-area: owns;
    }

    .stack {
      grid-area: stack;
    }
  }
</style>
