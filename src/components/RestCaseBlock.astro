---
import { localeOf } from "../diagrams/engine/locale_of";
import { responseMessage } from "../site/rest/response_message";
import { restCatalogueFor } from "../site/rest/rest_catalogue";
import { statusReasons } from "../site/rest/status_reasons";
import type { RestCaseProps } from "../site/types/rest_case_props.type";
import RestMessage from "./RestMessage.astro";
import RestText from "./RestText.astro";

type Props = RestCaseProps;

const { entry } = Astro.props;
const text = restCatalogueFor(localeOf(Astro.locals.starlightRoute.entryMeta.lang));
---

<div class="rest-case">
  <p class="rest-case-head">
    <span class="rest-status">{entry.status} {statusReasons[entry.status]}</span>
    <a class="rest-source" href={entry.source.href}>{entry.source.label}</a>
  </p>
  <p class="rest-when"><RestText text={text[entry.when]} /></p>
  <RestMessage text={responseMessage(entry)} />
</div>

<style>
  a {
    color: var(--sl-color-white);
    text-decoration: underline;
    text-decoration-color: var(--sl-color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  a:hover {
    color: var(--sl-color-accent);
  }

  .rest-case {
    padding: 0.875rem 0;
    border-top: 1px solid var(--kx-rule);
  }

  .rest-case-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0;
  }

  .rest-status {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .rest-source {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    overflow-wrap: anywhere;
  }

  .rest-when {
    margin: 0.375rem 0 0;
    color: var(--sl-color-gray-2);
  }
</style>
