---
import { LinkButton } from "@astrojs/starlight/components";
import SpecSheet from "../SpecSheet.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---

<div class="kx-hero">
  <div class="copy">
    {data.eyebrow && <p class="kicker">{data.eyebrow}</p>}
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
  <SpecSheet />
</div>

<style>
  .kx-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 3rem;
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(1rem, 2vw, 1.5rem);
  }

  @media (max-width: 50rem) {
    .kx-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .kicker {
    margin: 0;
    color: var(--sl-color-accent);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--sl-color-white);
    font-family: var(--kx-font-serif);
    font-size: clamp(3rem, 8vw, 5.25rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .tagline {
    max-width: 34rem;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: clamp(var(--sl-text-base), 1.5vw, var(--sl-text-lg));
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 0.25rem;
  }
</style>
