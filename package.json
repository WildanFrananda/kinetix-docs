{
  "name": "kinetix-docs",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun scripts/fetch_verifier.ts && astro dev",
    "build": "bun scripts/fetch_verifier.ts && astro build && bun scripts/write_csp.ts",
    "preview": "astro preview",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings",
    "check:translations": "bun scripts/check_translations.ts",
    "check:leaks": "bun scripts/check_leaks.ts",
    "fetch:verifier": "bun scripts/fetch_verifier.ts",
    "test": "bun test",
    "generate:grpc": "bun scripts/generate_grpc_reference.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "@astrojs/svelte": "9.1.2",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.7",
    "sharp": "0.35.5",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@bufbuild/protobuf": "2.17.0",
    "@types/bun": "1.4.4",
    "devicon": "2.18.0",
    "kinetix-contracts": "1.7.1",
    "starlight-links-validator": "0.27.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3"
  }
